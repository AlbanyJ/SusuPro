{
  "expo": {
    "name": "SusuPro",
    "slug": "SusuPro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#145534"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a7344",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SusuPro uses your photos to set a customer's profile picture.",
          "cameraPermission": "SusuPro uses your camera to take a customer's profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1a7344"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SusuPro uses Face ID to unlock the app after you've already signed in."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "kwame-nkrumah-university-of-ua"
        }
      ]
    ]
  }
}
