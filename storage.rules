// ============================================================
// storage.rules  ← Firebase Storage security rules
// WHAT:   Controls who can read/write customer photos.
//         Mirrors firestore.rules: only an admin can add/replace
//         a customer's photo (matches the app — only admins see
//         the "Add Customer" form and the "tap to change photo"
//         control), but any logged-in user can view photos.
//
// HOW TO DEPLOY:
//   firebase deploy --only storage
// ============================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Customer profile photos: customers/{customerId}/{fileName}
    match /customers/{customerId}/{fileName} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin()
                    && request.resource.size < 5 * 1024 * 1024   // 5MB max
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Everything else: deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
