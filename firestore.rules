// ============================================================
// FILE 24: firestore.rules  ← BACKEND SECURITY
// WHAT:   Rules that control who can read/write in Firebase.
//         These run ON FIREBASE'S SERVERS — not on the phone.
//         Even if someone hacks your app, these rules block them.
//
// HOW TO DEPLOY:
//   1. Install Firebase CLI: npm install -g firebase-tools
//   2. Login: firebase login
//   3. Init:  firebase init firestore
//   4. Deploy: firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────

    // Is the user logged in at all?
    function isLoggedIn() {
      return request.auth != null;
    }

    // Get the current user's role from the users collection
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Is the current user an admin?
    function isAdmin() {
      return isLoggedIn() && userRole() == 'admin';
    }

    // Is the current user a collector?
    function isCollector() {
      return isLoggedIn() && (userRole() == 'collector' || userRole() == 'admin');
    }


    // ── USERS collection ─────────────────────────────────────
    // Only admins can create or delete users.
    // Users can read their own profile.
    // A user editing their OWN profile can change things like their
    // name — but never their own role. Without that check, a
    // collector could just set role: 'admin' on themselves.
    match /users/{userId} {
      allow read:   if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       (request.auth.uid == userId &&
                        request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }


    // ── CUSTOMERS collection ──────────────────────────────────
    // Admins read/write everyone. A collector can only read the
    // customers assigned to them (the app's customer list queries
    // are scoped the same way — see customerService.fetchCustomers
    // — so this matches what the UI already restricts to, just
    // enforced server-side too), and can only touch their assigned
    // customers' balance (during a transaction) — never their
    // active status, photo, or collector assignment; those stay
    // admin-only, matching the UI.
    match /customers/{customerId} {
      allow read:   if isAdmin() ||
                       (isLoggedIn() && resource.data.collectorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       (isCollector() &&
                        resource.data.collectorId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt']));
      allow delete: if isAdmin();
    }


    // ── TRANSACTIONS collection ───────────────────────────────
    // Admins read/write everyone's. A collector can only read
    // transactions they recorded, and can only create a transaction
    // attributed to themselves (never impersonate another collector).
    // Nobody can edit or delete a transaction (audit integrity).
    match /transactions/{transactionId} {
      allow read:   if isAdmin() ||
                       (isLoggedIn() && resource.data.collectorId == request.auth.uid);
      allow create: if isAdmin() ||
                       (isCollector() && request.resource.data.collectorId == request.auth.uid);
      allow update: if false;   // NEVER allow editing transactions
      allow delete: if false;   // NEVER allow deleting transactions
    }


    // ── PENDING_WITHDRAWALS collection ────────────────────────
    // Collectors can only file a withdrawal request here (attributed
    // to themselves — never on another collector's behalf) — they
    // cannot move money themselves. A collector can only read their
    // own requests; an admin sees and approves/rejects everyone's.
    // Approving is what actually triggers the real transaction, over
    // in the transactions collection. Nobody can delete a request —
    // even rejected ones stay as a record of what was asked for.
    match /pendingWithdrawals/{withdrawalId} {
      allow read:   if isAdmin() ||
                       (isLoggedIn() && resource.data.requestedBy == request.auth.uid);
      allow create: if isAdmin() ||
                       (isCollector() && request.resource.data.requestedBy == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }


    // ── AUDIT_LOG collection ──────────────────────────────────
    // Only admins can read the audit log. Any logged-in user can
    // write an entry, but only attributed to themselves — nobody can
    // log an action as if someone else did it. Nobody can edit or
    // delete audit entries.
    match /audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }


    // ── Everything else: DENY by default ─────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
