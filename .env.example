# Copy this file to .env and fill in the values from:
# Firebase Console → Project Settings → Your apps → SDK setup and configuration
#
# EXPO_PUBLIC_ variables are inlined into the app bundle at build time
# by Expo — do not put anything here that must stay secret from end
# users (Firebase web config is not a secret, it's scoped by
# firestore.rules and Firebase Auth instead).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Customer photo uploads (Cloudinary — free tier, no card required).
# Create a free account at https://cloudinary.com, then:
#   1. Copy your "Cloud name" from the dashboard
#   2. Settings → Upload → Upload presets → Add upload preset
#        - Signing Mode: Unsigned
#   3. Paste both values below
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
