# Copy this file to .env and fill in the values from:
# Firebase Console → Project Settings → Your apps → SDK setup and configuration
#
# EXPO_PUBLIC_ variables are inlined into the app bundle at build time
# by Expo — do not put anything here that must stay secret from end
# users (Firebase web config is not a secret, it's scoped by
# firestore.rules and Firebase Auth instead).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
